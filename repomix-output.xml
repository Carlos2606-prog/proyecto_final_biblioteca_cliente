import co.edu.uptc.controller.ClientController;
import co.edu.uptc.view.DashBoard;
import javax.swing.JOptionPane;

public class App {
    public static void main(String[] args) {
        // 1. Pedir la IP al usuario antes de iniciar
        String ip = recoveryIP();
        
        // Si el usuario cancela, cerramos la aplicación
        if (ip == null || ip.trim().isEmpty()) {
            System.exit(0);
        }

        // 2. Iniciamos el Controlador con la IP ingresada
        ClientController controller = new ClientController(ip);
        
        // 3. Iniciamos la Vista y le pasamos el Controlador
        DashBoard dashBoard = new DashBoard(controller);
        dashBoard.setVisible(true);
    }

    // EL MÉTODO QUE QUERÍAS RECUPERAR (ADAPTADO A SWING)
    public static String recoveryIP() {
        return JOptionPane.showInputDialog(
            null, 
            "Digite la IP del servidor:", 
            "Conexión al Servidor", 
            JOptionPane.QUESTION_MESSAGE
        );
    }
}
